# Copy to mobile/.env.local (gitignored) and fill in. Restart with
# `npx expo start -c` after editing -- EXPO_PUBLIC_* values are baked in at
# bundle time.
#
# EXPO_PUBLIC_* values ship inside the app bundle, so only PUBLIC keys go here.
# Never put CLERK_SECRET_KEY or the Supabase service_role key in this file.

# Same Clerk dev instance as your web app: copy the value of
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY from the repo root's .env.local.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Local Supabase from `npm run setup` in the repo root. Copy the anon key from
# NEXT_PUBLIC_SUPABASE_ANON_KEY in the root .env.local.
# - iOS simulator:     http://127.0.0.1:54321
# - Android emulator:  http://10.0.2.2:54321
# - Physical phone:    http://<your computer's LAN IP>:54321 (same Wi-Fi)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
